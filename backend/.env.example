# Copy to .env (or export directly) — all have working defaults for local dev.

# sqlite (default, zero setup) or a Postgres URL, e.g.:
# postgres://neurodetect:devpassword@localhost:5432/neurodetect
DATABASE_URL=sqlite:///./app.db

UPLOAD_DIR=./uploads
RESULTS_DIR=./results
MAX_UPLOAD_MB=20

# Comma-separated list — must include whatever origin the frontend runs on
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Documented default only — no scheduled job currently enforces this, see README
DATA_RETENTION_DAYS=90
