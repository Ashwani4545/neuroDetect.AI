# Copy to .env (or export directly) — all have working defaults for local dev.

# sqlite (default, zero setup) or a Postgres URL, e.g.:
# postgres://neurodetect:devpassword@localhost:5432/neurodetect
DATABASE_URL=sqlite:///./app.db

UPLOAD_DIR=./uploads
RESULTS_DIR=./results
MAX_UPLOAD_MB=20

# Comma-separated list — must include whatever origin the frontend runs on
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_TOKEN_DAYS=7

# OAuth callback URLs:
# Google:    http://localhost:8000/api/auth/google/callback
# LinkedIn:  http://localhost:8000/api/auth/linkedin/callback
# Facebook:  http://localhost:8000/api/auth/facebook/callback
# Instagram: http://localhost:8000/api/auth/instagram/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# Documented default only — no scheduled job currently enforces this, see README
DATA_RETENTION_DAYS=90
